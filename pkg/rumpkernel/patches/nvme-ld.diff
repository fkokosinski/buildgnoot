--- /dev/null
+++ b/buildrump.sh/src/sys/rump/dev/lib/libpci_ld_nvme/ld_nvme_component.c
@@ -0,0 +1,35 @@
+#include <sys/param.h>
+#include <sys/conf.h>
+#include <sys/device.h>
+#include <sys/disklabel.h>
+
+#include "ioconf.h"
+
+#include <rump-sys/kern.h>
+#include <rump-sys/vfs.h>
+
+RUMP_COMPONENT(RUMP_COMPONENT_POSTINIT)
+{
+  extern const struct bdevsw ld_bdevsw;
+  extern const struct cdevsw ld_cdevsw;
+  devmajor_t bmaj, cmaj;
+  int error, i;
+
+  bmaj = bdevsw_lookup_major(&ld_bdevsw);
+  cmaj = cdevsw_lookup_major(&ld_cdevsw);
+
+  for (i = 0; i < 7; i++)
+    {
+      char bbase[] = "/dev/ldX";
+      char rbase[] = "/dev/rldX";
+
+      if (device_lookup(&ld_cd, i) == NULL)
+	break;
+
+      bbase[sizeof(bbase)-2] = '0' + i;
+      rbase[sizeof(rbase)-2] = '0' + i;
+
+      FLAWLESSCALL(rump_vfs_makedevnodes(S_IFBLK, bbase, 'a', bmaj, DISKMINOR(i, 0), 4));
+      FLAWLESSCALL(rump_vfs_makedevnodes(S_IFCHR, rbase, 'a', cmaj, DISKMINOR(i, 0), 4));
+    }
+}
