config PKG_GNUMACH_HEADERS
	bool "GNU Mach headers (host)"
	default y
	help
	  GNU Mach headers. Used by the cross-compiler.

	  If unsure, say 'Y'.

config PKG_GNUMACH
	bool "GNU Mach"
	default y
	help
	  GNU Mach kernel. The base of the GNU operating system.

	  If unsure, say 'Y'.
