config BG_ROOTFS
	bool "Buildgnoot root filesystem"
	default y
	select PKG_BASH
	select PKG_COREUTILS
	select PKG_E2FSPROGS
	select PKG_GLIBC
	select PKG_GNUMACH
	select PKG_GRUB
	select PKG_HURD
	select PKG_LIBXCRYPT
	select PKG_LIBPCIACCESS
	select PKG_SED
	select PKG_SHADOW
	select PKG_ZLIB
	help
	  Buildgnoot root filesystem.
