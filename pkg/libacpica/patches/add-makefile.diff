+OBJS = $(SRCS:.c=.o)
+
+all: libacpica.a libacpica.so.0
+	@echo Done
+
+libacpica.a: $(OBJS)
+	ar crs $@ $(OBJS)
+
+libacpica.so.0: $(OBJS)
+	$(CC) $(LDFLAGS) -shared -Wl,-soname=$@ $(OBJS) -o $@ $(LDLIBS)
+
+clean:
+	rm -f *.o $(BASE)/*.o libacpica.a libacpica.so*
+
+install:
+	install -d $(DESTDIR)$(PREFIX)/include/acpi/platform
+	install -t $(DESTDIR)$(PREFIX)/include/acpi/platform include/acpi/platform/*.h
+	install -t $(DESTDIR)$(PREFIX)/include/acpi include/acpi/*.h
+	install -d $(DESTDIR)$(libdir)
+	install libacpica.a $(DESTDIR)$(libdir)
+	install libacpica.so.0 $(DESTDIR)$(libdir)
+	ln -sf libacpica.so.0 $(DESTDIR)$(libdir)/libacpica.so
