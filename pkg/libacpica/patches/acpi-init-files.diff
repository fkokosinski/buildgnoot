+static error_t
+acpi_mach_efi_root (acpi_physical_address *pa)
+{
+#ifdef HOST_EFI_SYSTAB
+  mach_msg_type_number_t size = HOST_EFI_SYSTAB_COUNT;
+  host_efi_systab_data_t systab;
