+  uint64_t signature;
+  uint32_t revision;
+  uint32_t size;
+  uint32_t crc32;
+  uint32_t reserved;
+};
+
+typedef uint64_t efi_pa_t;
+typedef uint64_t efi_handle_t;
+typedef uint8_t  efi_guid_t[16];
+
+struct efi_system_table64
+{
+  struct efi_table_header hdr;
+
+  efi_pa_t     fw_vendor_pa;
+  uint32_t     fw_revision;
+  uint32_t     pad1;
+  efi_handle_t con_in_handle;
+  efi_pa_t     con_in;
+  efi_handle_t con_out_handle;
+  efi_pa_t     con_out;
+  efi_handle_t stderr_handle;
+  efi_pa_t     stderr;
+  efi_pa_t     runtime;
+  efi_pa_t     boottime;
+  uint32_t     nr_tables;
+  uint32_t     pad2;
+  efi_pa_t     tables;
+};
+
+struct efi_config_table64
+{
+  efi_guid_t guid;
+  efi_pa_t   table;
+};
+
+static const efi_guid_t acpi0_table_guid = {
+  0x30, 0x2d, 0x9d, 0xeb,
+  0x88, 0x2d,
+  0xd3, 0x11,
+  0x9a, 0x16, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d
+};
+
+static const efi_guid_t acpi2_table_guid = {
+  0x71, 0xe8, 0x68, 0x88,
+  0xf1, 0xe4,
+  0xd3, 0x11,
+  0xbc, 0x22, 0x00, 0x80, 0xc7, 0x3c, 0x88, 0x81
+};
+
+#define EFI_SYSTEM_TABLE_SIGNATURE 0x5453595320494249ULL
+
+static uint64_t
+acpi_root_pointer_from_efi (void)
+{
+  uint64_t result = ACPI_INVALID_PHYSADDR;
+  uint64_t efi_system;
+
+  if (acpi_mach_efi_root (&efi_system))
+    return result;
+
+  struct efi_system_table64 *efi_ptr = (struct efi_system_table64 *)
+    acpi_os_map_memory (efi_system, sizeof (struct efi_system_table64));
+
+  if (efi_ptr == MAP_FAILED)
+    return result;
+
+  if (efi_ptr->hdr.signature == EFI_SYSTEM_TABLE_SIGNATURE
+      && efi_ptr->nr_tables > 0)
+    {
+      const acpi_size ct_sz = (sizeof (struct efi_system_table64) * efi_ptr->nr_tables);
+      struct efi_config_table64 *config_tables =
+	(struct efi_config_table64 *)acpi_os_map_memory	(efi_ptr->tables, ct_sz);
+
+      if (config_tables != MAP_FAILED)
+	{
+	  for (unsigned int i = 0; i < efi_ptr->nr_tables; i++)
+	    {
+	      if (memcmp (&config_tables->guid,
+			  &acpi2_table_guid,
+			  sizeof(efi_guid_t)) == 0)
+		{
+		  result = config_tables->table;
+		  /* Higher versions are preferred. */
+		  break;
+		}
+	      else if (memcmp (&config_tables->guid,
+			       &acpi0_table_guid,
+			       sizeof(efi_guid_t)) == 0)
+		{
+		  result = config_tables->table;
+		}
+
+	      config_tables++;
+	    }
+
+	  acpi_os_unmap_memory (config_tables, ct_sz);
+	}
+    }
+
+  acpi_os_unmap_memory (efi_ptr, sizeof(struct efi_system_table64));
+
+  if (result != ACPI_INVALID_PHYSADDR)
+    {
+      struct acpi_rsdp_common *rsdp_ptr = (struct acpi_rsdp_common *)
+	acpi_os_map_memory (result, sizeof (struct acpi_rsdp_common));
+
+      if (rsdp_ptr == MAP_FAILED)
+	{
+	  result = ACPI_INVALID_PHYSADDR;
+	}
+      else
+	{
+	  if (memcmp (rsdp_ptr->signature,
+		      ACPI_SIG_RSDP,
+		      sizeof(rsdp_ptr->signature)))
+	    {
+	      result = ACPI_INVALID_PHYSADDR;
+	    }
+
+	  acpi_os_unmap_memory (rsdp_ptr, sizeof(struct acpi_rsdp_common));
+	}
+    }
+
+  return result;
+}
+#endif /* __x86_64__ */
+
+acpi_physical_address
+acpi_os_get_root_pointer(void)
+{
+  acpi_physical_address pa = ACPI_INVALID_PHYSADDR;
+
+#ifdef __x86_64__
+  uint64_t rsdp = acpi_root_pointer_from_efi ();
+
+  if (rsdp != ACPI_INVALID_PHYSADDR)
+    pa = rsdp;
+#endif /* __x86_64__ */
+
+  if (pa == ACPI_INVALID_PHYSADDR)
+    acpi_find_root_pointer(&pa);
+
+  return pa;
+}
