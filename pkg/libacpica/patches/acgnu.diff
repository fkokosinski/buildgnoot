+
+/* Supposed to be 64 bit free-running
+ * monotonic timer with 100ns granularity
+ */
+static inline u64
+acpi_os_get_timer(void)
+{
+  struct timespec now;
+
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (u64)((u64)now.tv_sec * 10000000 + (now.tv_nsec / 100));
+}
+
+static inline acpi_status
+acpi_os_read_iomem(void *virt_addr, u64 *value, u32 width)
+{
+  switch (width)
+    {
+      case 8:
+        *(u8 *) value = *((volatile u8 *)virt_addr);
+        break;
+      case 16:
+        *(u16 *) value = *((volatile u16 *)virt_addr);
+        break;
+      case 32:
+        *(u32 *) value = *((volatile u32 *)virt_addr);
+        break;
+      case 64:
+        *(u64 *) value = *((volatile u64 *)virt_addr);
+        break;
+      default:
+        return 1;
+    }
+  return 0;
+}
+
+static inline void
+acpi_os_sleep(u64 ms)
+{
+  usleep(1000 * ms);
+}
+
+static inline void
+acpi_os_stall(u32 us)
+{
+  usleep(us);
+}
+
+static inline void
+acpi_os_wait_events_complete(void)
+{
+  return;
+}
+
+static inline acpi_status
+acpi_os_read_port(acpi_io_address port, u32 *value, u32 width)
+{
+  if (!value)
+    return 1;
+
+  switch (width)
+    {
+      case 8:
+        *((u8 *)value) = inb(port);
+        return 0;
+      case 16:
+        *((u16 *)value) = inw(port);
+        return 0;
+      case 32:
+        *((u32 *)value) = inl(port);
+        return 0;
+      default:
+        acpi_os_printf("ACPI: read port invalid width\n");
+        return 1;
+    }
+  return 1;
+}
+
+static inline acpi_status
+acpi_os_write_port(acpi_io_address port, u32 value, u32 width)
+{
+  switch (width)
+    {
+      case 8:
+        outb(value, port);
+        return 0;
+      case 16:
+        outw(value, port);
+        return 0;
+      case 32:
+        outl(value, port);
+        return 0;
+      default:
+        acpi_os_printf("ACPI: Bad write port width\n");
+        return 1;
+    }
+
+  return 1;
+}
+
+static inline acpi_status
+acpi_os_install_interrupt_handler(u32 gsi, acpi_osd_handler handler,
+          void *context)
+{
+  assert(gsi < ACPI_MAX_GSIS);
+  pthread_t irq_loop;
+  int err;
+
+  if (handlers[gsi].irqhelp)
+    irqhelp_remove_interrupt_handler (handlers[gsi].irqhelp);
+  handlers[gsi].irqhelp = irqhelp_install_interrupt_handler (gsi, -1, -1, -1, (void *)(void (*))handler, context);
+
+  err = pthread_create (&irq_loop, NULL, irqhelp_server_loop, handlers[gsi].irqhelp);
+  if (err)
+    {
+      acpi_os_printf ("ACPI: Cannot create pthread for interrupt handler gsi=%d\n", gsi);
+      irqhelp_remove_interrupt_handler (handlers[gsi].irqhelp);
+      handlers[gsi].irqhelp = NULL;
+      return 1;
+    }
+  pthread_detach (irq_loop);
+  return 0;
+}
+
+static inline acpi_status
+acpi_os_remove_interrupt_handler(u32 gsi, acpi_osd_handler handler)
+{
+  int err = irqhelp_remove_interrupt_handler (handlers[gsi].irqhelp);
+  if (err)
+    {
+      acpi_os_printf ("ACPI: Cannot deregister interrupt handler gsi=%d\n", gsi);
+      return 1;
+    }
+  handlers[gsi].irqhelp = NULL;
+  return 0;
+}
+
+static inline acpi_status
+acpi_os_read_pci_configuration(struct acpi_pci_id * pci_id, u32 reg,
+             u64 *value, u32 bit_width)
+{
+  int i, err = 0;
+  uint8_t buf[8] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+  struct pci_device *dev;
+  u64 temp = 0;
+  u32 bytes = bit_width / 8;
+  pciaddr_t bytes_read = 0;
+
+  if (bytes > 8)
+    {
+      acpi_os_printf("acpi: Can't read more than 8 pci bytes\n");
+      return 1;
+    }
+
+  dev = lookup_pci_dev(pci_id);
+  if (!dev)
+    return 1;
+
+  pci_device_cfg_read(dev, buf, reg, bytes, &bytes_read);
+  if (bytes_read < bytes)
+    {
+      acpi_os_printf("acpi: pci short read\n");
+      err = 1;
+    }
+
+  /* Read buffer from LE */
+  for (i = 0; i < bytes; i++)
+    temp |= buf[i] << (8 * i);
+
+  *value = temp;
+
+  return err;
+}
+
+static inline acpi_status
+acpi_os_write_pci_configuration(struct acpi_pci_id * pci_id, u32 reg,
+        u64 value, u32 bit_width)
+{
+  int i, err = 0;
+  uint8_t buf[8] = {0};
+  struct pci_device *dev;
+  u32 bytes = bit_width / 8;
+  pciaddr_t bytes_written = 0;
+
+  if (bytes > 8)
+    {
+      acpi_os_printf("acpi: Can't write more than 8 pci bytes\n");
+      return 1;
+    }
+
+  dev = lookup_pci_dev(pci_id);
+  if (!dev)
+    return 1;
+
+  /* Encode value as LE buffer */
+  for (i = 0; i < bytes; i++)
+    buf[i] = (value >> (8 * i)) & 0xff;
+
+  pci_device_cfg_write(dev, buf, reg, bytes, &bytes_written);
+  if (bytes_written < bytes)
+    {
+      acpi_os_printf("acpi: pci short write\n");
+      err = 1;
+    }
+
+  return err;
+}
+
